# GengoWatcher Configuration Example
# Copy this file to config.toml and fill in your values
# Sensitive values can also be set via environment variables (see .env.example)

[Watcher]
feed_url = "https://gengo.com/rss/available_jobs/YOUR_RSS_FEED_TOKEN"
check_interval = 31
gengo_rss_interval_min_sec = 31
gengo_rss_interval_max_sec = 60
min_reward = 0.0
enable_notifications = true
enable_sound = true
use_custom_user_agent = false

[WebSocket]
enable_websocket = true
use_gateway = false
gateway_url = "http://127.0.0.1:8000"
wss_url = "wss://live-dashboard.gengo.com/"
# Set via GENGO_USER_ID env var or here
user_id = "YOUR_USER_ID"
# Set via GENGO_USER_SESSION env var or here
user_session = "YOUR_SESSION_TOKEN"
user_key = "REPLACE_WITH_YOUR_USER_KEY"
browser_debug_url = ""
session_sync_interval_sec = 14400
session_quiet_probe_sec = 90
session_quiet_stale_after_sec = 300
planned_reconnect_min_sec = 300
planned_reconnect_max_sec = 3600
browser_activity_min_sec = 300
browser_activity_max_sec = 3600
session_sync_fail_hard = true
session_sync_alert_on_failure = true

[Paths]
log_file = "logs/gengowatcher.log"
notification_icon_path = "/path/to/icon.png"
browser_path = "/usr/bin/google-chrome"
browser_args = "--new-window {url}"
all_entries_log = "logs/all_entries.csv"
sound_file = "assets/alert.wav"
# Optional override for websocket stale alerts; falls back to sound_file when blank
websocket_stale_sound_file = ""
# Optional override for browser session sync failure alerts; falls back to sound_file when blank
browser_session_sync_failed_sound_file = ""
# Local storage for uploaded/downloadable release files exposed by the web API
file_storage_dir = "data/files"

[Logging]
log_max_bytes = 1000000
log_backup_count = 3
log_main_enabled = true
log_stdio_enabled = false
log_all_entries_enabled = true

[UI]
theme_name = "nord"

[DebugCategories]
websocket = true
rss = true
job = true
browser = true
config = true
system = true
email = true
website = true
raw = false

[Network]
max_backoff = 300
user_agent_email = "your-email@example.com"
browser_user_agent = "Mozilla/5.0"
browser_accept_language = "en-GB,en-US;q=0.9"
detect_browser_ua = false
clean_close_backoff_min = 20
clean_close_backoff_max = 45
reconnect_jitter_max = 5

[RateLimit]
max_acceptances_per_hour = 30

[WebServer]
enabled = false
host = "127.0.0.1"
port = 8000
cors_origins = ["http://localhost:5173", "http://127.0.0.1:5173"]
# Set via GENGOWATCHER_API_TOKEN env var or here
auth_token = "REPLACE_WITH_YOUR_WEB_API_TOKEN"

[TranslationApp]
enabled = false
base_url = "http://127.0.0.1:8080"
# Set via TRANSLATION_APP_AUTH_TOKEN env var or here
auth_token = "REPLACE_WITH_YOUR_TRANSLATION_APP_TOKEN"
timeout_sec = 5.0
verify_tls = true

[TranslationWorkflow]
# user: wait for /api/files/upload with job_id after acceptance.
# auto: try to download a file URL found in the accepted workbench JSON.
# none: start the workflow from workbench JSON text only.
file_mode = "user"
download_timeout_sec = 30.0
file_text_max_chars = 250000
file_retention_days = 30

[Webhooks]
incoming_enabled = false
# Set via GENGOWATCHER_WEBHOOK_SECRET env var or here
incoming_secret = ""
require_signature = true
signature_tolerance_sec = 300.0
max_seen_event_ids = 1000
debug_enabled = false
debug_payload_preview_bytes = 4096
audit_enabled = true
audit_log_path = "logs/webhooks.jsonl"
audit_retention_days = 30
outbound_enabled = false
outbound_urls = []
# Set via GENGOWATCHER_WEBHOOK_OUTBOUND_SECRET env var or here
outbound_secret = ""
# Set via GENGOWATCHER_WEBHOOK_OUTBOUND_AUTH_TOKEN env var or here
outbound_auth_token = ""
outbound_timeout_sec = 5.0
outbound_max_attempts = 3
outbound_initial_delay_sec = 0.5
outbound_max_delay_sec = 10.0
outbound_verify_tls = true
outbound_include_customer_content = false

[AutoAccept]
enabled = false
min_reward = 0.0
max_reward = 999999.0
job_sources = "rss,websocket"
accept_delay_min = 5
accept_delay_max = 30
browser_profile_path = ""
notification_on_accept = true
log_acceptance = true
concurrent_submission = true
accept_click_probe_ms = 75
attempt_timeout_sec = 12
selenium_attempt_timeout_sec = 8
# Keep false in native browser mode. Set true only for the legacy direct HTTP accept path.
allow_http_fallback = false

[Browser]
backend = "native"
require_visible_browser = true
allow_playwright = false
headless = false
debug_url = "ws://127.0.0.1:6000"

[NativeBrowserListener]
enabled = false
capture_interval_ms = 750
status_poll_seconds = 5

[BrowserJobs]
# BrowserJobs monitor is now event-driven by default. It wakes when:
#   - The native browser listener publishes a workbench-visible event, OR
#   - A job.discovered / job.details event lands from any source, OR
#   - An explicit TUI / CLI command calls trigger_browser_jobs_refresh().
# No fixed polling cadence is used. The idle_cap_sec below bounds how often
# the monitor runs a passive keepalive eval when nothing has happened.
enabled = true
allow_navigation = false
idle_cap_sec = 1800

[BrowserWorker]
enabled = false
socket_path = ""
# Start with: gengowatcher-browser-worker --profile-path profiles/browser-worker
profile_path = "profiles/browser-worker"
seed_profile_path = ""
headless = false
artifacts_dir = "logs/browser-worker-artifacts"

[HighValue]
threshold = 500.0
very_high_threshold = 1000.0
extreme_threshold = 5000.0
immediate_response = true
min_processing_delay = 0.001
max_per_day = 999
min_interval_seconds = 1
desktop_notifications = true
notify_on_missed = true
extreme_value_no_daily_limit = true
extreme_value_no_interval = true

[Cancellation]
enabled = false
min_improvement_ratio = 2.0
extreme_threshold = 1000.0
auto_cancel_extreme_value = true

[EmailMonitor]
enabled = false
email = "your-email@gmail.com"
# OAuth credentials - prefer environment variables:
# GMAIL_CLIENT_ID, GMAIL_CLIENT_SECRET, GMAIL_REFRESH_TOKEN
client_id = "YOUR_CLIENT_ID"
client_secret = "YOUR_CLIENT_SECRET"
refresh_token = "YOUR_REFRESH_TOKEN"
access_token = ""
token_expiry = 0
folder = "INBOX"
from_filter = "no-reply@gengo.com"
poll_fallback_interval = 60

[WebsiteMonitor]
enabled = false
jobs_url = "https://gengo.com/t/jobs/"
check_interval_min = 120
check_interval_max = 300
headless = true
session_cookie = ""
browser_executable = ""
