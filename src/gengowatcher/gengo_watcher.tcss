/* ══════════════════════════════════════════════════════════════════════════
   KANAGAWA WAVE COLOR PALETTE
   Source: https://github.com/rebelot/kanagawa.nvim
   ══════════════════════════════════════════════════════════════════════════ */

/* ── Background Shades ─────────────────────────────────────────────────── */
$surface: #1F1F28;              /* sumiInk3 - primary surface */
$surface-darken-1: #16161D;     /* sumiInk0 - deepest background */
$surface-lighten-1: #2A2A37;    /* sumiInk4 - elevated surfaces */
$surface-lighten-2: #363646;    /* sumiInk5 - borders, separators */

/* ── Panel & Accent ────────────────────────────────────────────────────── */
$panel-bg: #2A2A37;             /* sumiInk4 - panel background */
$primary: #7E9CD8;              /* crystalBlue - main accent */
$primary-darken-2: #5D7BC0;     /* darker crystal blue */
$secondary: #957FB8;            /* oniViolet - secondary accent */
$accent: #7AA89F;               /* waveAqua2 - accent/cyan */

/* ── Semantic Colors ───────────────────────────────────────────────────── */
$success: #98BB6C;              /* springGreen */
$warning: #DCA561;              /* autumnYellow */
$error: #C34043;                /* autumnRed */

/* ── Visual Hierarchy Depths ──────────────────────────────────────────── */
$depth-0: #16161D;              /* Deepest - screen background */
$depth-1: #1F1F28;              /* Main surface - tab panes */
$depth-2: #2A2A37;              /* Elevated - cards, panels */
$depth-3: #363646;              /* Borders, separators */

/* ── Card Accent Colors ────────────────────────────────────────────────── */
$card-found: #7E9CD8;           /* primary - blue */
$card-accepted: #98BB6C;        /* success - green */
$card-value: #DCA561;           /* warning - yellow */
$card-rate: #7AA89F;            /* accent - aqua */
$card-minword: #957FB8;         /* secondary - violet */

/* ── Text Colors ───────────────────────────────────────────────────────── */
$text: #DCD7BA;                 /* fujiWhite - primary text */
$text-muted: #727169;           /* fujiGray - muted text */

Screen {
    layout: vertical;
    background: $surface;
    color: $text;
}

/* Top Application Header */
#app-header {
    dock: top;
    height: 1;
    background: $primary;
    color: $surface-darken-1;
    text-align: center;
    text-style: bold;
}

/* Main Content Area */
#main-container {
    layout: vertical;
    height: 1fr;
    background: $surface;
}

/* Panels */
#header-panel, #runtime-panel {
    background: $panel-bg;
    border: round $primary;
    border-title-color: $accent;
    padding: 0 1;
    margin-bottom: 1;
    width: 100%;
}

#header-panel {
    border: round $secondary;
    border-title-color: $secondary;
    height: auto;
}

#runtime-panel {
    layout: grid;
    grid-size: 4;
    grid-columns: auto 1fr auto 1fr;
    grid-gutter: 1 2;
    height: auto;
}

/* Logs */
#activity-log, #output-log, #debug-log {
    background: $surface-darken-1;
    border: round $surface-lighten-2;
    border-title-color: $text-muted;
    height: 1fr;
    scrollbar-background: $surface;
    scrollbar-color: $primary;
}

#activity-log { border: round $success; border-title-color: $success; }
#output-log { border: round $warning; border-title-color: $warning; }
#debug-log { border: round $accent; border-title-color: $accent; }

/* Activity Preview RichLog inside quadrant */
#activity-preview-log {
    height: 1fr;
    background: $depth-1;
    scrollbar-background: $surface;
    scrollbar-color: $primary;
}

/* Bottom Area Container - Fixed height to prevent overlap */
#bottom-area {
    height: 4;
    dock: bottom;
    background: $surface;
}

/* Bottom Status Bar */
#status-bar {
    height: 1;
    background: $surface-lighten-1;
    color: $text;
    padding: 0 1;
    text-style: bold;
}

/* Command Input */
Input {
    height: 3;
    border: round $surface-lighten-2;
    background: $surface-darken-1;
    color: $text;
}
Input:focus {
    border: round $accent;
}
Input > .input--placeholder {
    color: $text-muted;
}

/* TabbedContent Styling */
TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 0;
    background: $surface;
}

/* Tab Headers */
Tabs {
    background: $surface-darken-1;
    dock: top;
    height: 1;
}

Tab {
    height: 1;
    padding: 0 2;
    color: $text-muted;
    background: $surface-darken-1;
}

Tab:hover {
    color: $text;
    background: $surface-lighten-1;
}

Tab.-active {
    color: $surface;
    background: $accent;
    text-style: bold;
}

/* DataTable Styling */
DataTable {
    background: $surface-darken-1;
    height: 1fr;
    border: none;
}
DataTable > .datatable--header {
    background: $primary-darken-2;
    color: $surface;
    text-style: bold;
}
DataTable > .datatable--cursor {
    background: $primary;
    color: $surface;
}
DataTable > .datatable--hover {
    background: $surface-lighten-1;
}

/* Modal Styling */
ModalScreen {
    align: center middle;
    background: $surface 50%;
}

HelpScreen {
    align: center middle;
}

#help-container {
    width: 80;
    height: auto;
    max-height: 80%;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
}

#help-title {
    text-style: bold;
    text-align: center;
    border-bottom: solid $secondary;
    margin-bottom: 1;
    width: 100%;
}

#help-list {
    height: auto;
    max-height: 1fr;
}

.help-footer {
    text-align: center;
    margin-top: 1;
    color: $text-muted;
}

/* ScrollBar Styling */
ScrollBar {
    background: $surface;
    width: 1;
}
ScrollBar > .scrollbar--thumb {
    background: $primary;
}

/* Runtime Status Panel internals */
.status-label {
    color: $text-muted;
    text-style: bold;
    padding-right: 1;
}

.status-value {
    color: $text;
    text-style: bold;
}

.span-2 { column-span: 2; }
.span-3 { column-span: 3; }
.span-4 { column-span: 4; }

.sparkline-label {
    margin-top: 1;
    text-style: bold;
    color: $accent;
}

#sparkline {
    height: 1;
    color: $accent;
}

/* Status indicator classes (Badges) */
.status-badge {
    background: $surface-lighten-1;
    color: $text;
    padding: 0 1;
    text-align: center;
}

.status-live { color: $success; }
.status-connecting { color: $warning; }
.status-offline { color: $error; }

.status-text-green { color: $success; }
.status-text-orange { color: $warning; }
.status-text-cyan { color: $accent; }
.status-text-dim { color: $text-muted; }

/* Email Monitor Status */
.status-email-idle { color: $success; }
.status-email-polling { color: $accent; }
.status-email-connecting { color: $warning; }
.status-email-error { color: $error; }

/* Website Monitor Status */
.status-website-scraping { color: $warning; }
.status-website-idle { color: $success; }
.status-website-init { color: $accent; }
.status-website-error { color: $error; }

/* Monitor section separator */
.monitor-section-label {
    margin-top: 1;
    color: $secondary;
    text-style: bold italic;
    column-span: 4;
}

/* ══════════════════════════════════════════════════════════════════════════
   PHASE 2: TABBED NAVIGATION LAYOUT
   ══════════════════════════════════════════════════════════════════════════ */

/* Dashboard tab content layout */
#dashboard-content {
    layout: vertical;
    height: 1fr;
    padding: 0;
}

#dashboard-content #runtime-panel {
    height: auto;
}

#dashboard-content #header-panel {
    height: auto;
}

/* Charts placeholder */
#charts-placeholder {
    width: 100%;
    height: 100%;
    content-align: center middle;
    color: $text-muted;
}

/* Ensure main-tabs fills space */
#main-tabs {
    height: 1fr;
}

/* ══════════════════════════════════════════════════════════════════════════
   TITLE BAR
   ══════════════════════════════════════════════════════════════════════════ */

TitleBar {
    height: 3;
    background: $depth-2;
    border-left: tall $primary;
    padding: 0 2;
    layout: vertical;
}

TitleBar .title-row {
    height: 1;
    width: 100%;
}

TitleBar .brand {
    color: $primary;
    text-style: bold;
    width: auto;
}

TitleBar .watcher-status {
    margin-left: 2;
    width: auto;
}

TitleBar .watcher-status.running { color: $success; }
TitleBar .watcher-status.paused { color: $warning; }
TitleBar .watcher-status.stopped { color: $error; }

TitleBar .job-count {
    margin-left: 2;
    color: $accent;
    width: auto;
}

TitleBar .session-time {
    color: $text;
    width: auto;
}

TitleBar .last-check {
    margin-left: 2;
    color: $text-muted;
    width: auto;
}

TitleBar .clock {
    color: $text-muted;
    text-align: right;
    width: 1fr;
}

/* ══════════════════════════════════════════════════════════════════════════
   METRIC CARDS
   ══════════════════════════════════════════════════════════════════════════ */

MetricsRow {
    height: 5;
    padding: 0 1;
    align: center middle;
}

MetricCard {
    width: 14;
    height: 3;
    background: $depth-2;
    border: round $depth-3;
    padding: 0 1;
    margin: 0 1;
}

MetricCard.found { border-left: tall $card-found; }
MetricCard.accepted { border-left: tall $card-accepted; }
MetricCard.value { border-left: tall $card-value; }
MetricCard.rate { border-left: tall $card-rate; }
MetricCard.minword { border-left: tall $card-minword; }

MetricCard .metric-value {
    color: $text;
    text-style: bold;
}

MetricCard .metric-label {
    color: $text-muted;
}

/* ══════════════════════════════════════════════════════════════════════════
   STATUS ROW
   ══════════════════════════════════════════════════════════════════════════ */

StatusRow {
    height: 1;
    padding: 0 2;
    background: $depth-1;
}

StatusIndicator {
    width: auto;
    margin-right: 3;
}

StatusIndicator .status-icon {
    margin-right: 1;
}

StatusIndicator .status-live { color: $success; }
StatusIndicator .status-working { color: $warning; }
StatusIndicator .status-error { color: $error; }
StatusIndicator .status-idle { color: $text-muted; }

/* ══════════════════════════════════════════════════════════════════════════
   DASHBOARD QUADRANTS
   ══════════════════════════════════════════════════════════════════════════ */

.dashboard-grid {
    layout: grid;
    grid-size: 2 2;
    grid-gutter: 1;
    padding: 1;
    height: 1fr;
}

DashboardQuadrant {
    background: $depth-2;
    border: round $depth-3;
    padding: 0 1;
    height: 1fr;
}

DashboardQuadrant.activity { border-left: tall $success; }
DashboardQuadrant.jobs-preview { border-left: tall $primary; }
DashboardQuadrant.chart { border-left: tall $accent; }
DashboardQuadrant.config { border-left: tall $secondary; }

DashboardQuadrant .quadrant-title {
    color: $text;
    text-style: bold;
    padding-bottom: 1;
}

/* Command Response Box (4th quadrant) */
.command-response-box {
    background: $depth-2;
    border: round $depth-3;
    border-left: tall $warning;
    padding: 0 1;
    height: 1fr;
}

.command-response-box .quadrant-title {
    color: $text;
    text-style: bold;
    padding-bottom: 1;
}

#cmd-response {
    height: 1fr;
    background: $depth-1;
    scrollbar-background: $surface;
    scrollbar-color: $primary;
}

/* ══════════════════════════════════════════════════════════════════════════
   STATS PANEL
   ══════════════════════════════════════════════════════════════════════════ */

StatsPanel {
    padding: 1;
}

.stats-grid {
    layout: grid;
    grid-size: 2;
    grid-gutter: 1;
}

.stats-section {
    background: $depth-2;
    border: round $depth-3;
    padding: 1;
}

.stats-section.session { border-left: tall $primary; }
.stats-section.alltime { border-left: tall $secondary; }
.stats-section.source { border-left: tall $accent; }
.stats-section.language { border-left: tall $warning; }
.stats-section.times { border-left: tall $success; }

.stats-section .section-title {
    color: $text;
    text-style: bold;
    padding-bottom: 1;
}

.stats-row {
    height: 1;
}

.stats-label {
    color: $text-muted;
    width: 16;
}

.stats-value {
    color: $text;
}

.progress-bar {
    width: 100%;
    height: 1;
}

.progress-bar .bar-fill {
    background: $primary;
}

.progress-bar .bar-empty {
    background: $depth-3;
}
