/* Kanagawa Theme Colors (Corrected Palette) */
$surface: #1F1F28;          /* Sumi Ink 1 */
$surface-lighten-1: #2A2A37; /* Sumi Ink 2 */
$text: #DCD7BA;             /* Fuji White */
$text-muted: #727169;       /* Fuji Gray */

/* Accents */
$accent-blue: #7E9CD8;      /* Crystal Blue */
$accent-green: #98BB6C;     /* Spring Green */
$accent-red: #C34043;       /* Samurai Red */
$accent-orange: #FFA066;    /* Surimi Orange */
$accent-yellow: #E6C384;    /* Carp Yellow */
$accent-violet: #957FB8;    /* Oni Violet */
$accent-aqua: #7AA89F;      /* Wave Aqua 1 */

Screen {
    background: $surface;
    color: $text;
}

/* ============================================================================
   Layout Components
   ============================================================================ */

/* Title Bar */
TitleBar {
    height: 3;
    background: $surface-lighten-1;
    border-bottom: solid $surface;
    dock: top;
    layout: vertical;
    align: center middle;
}

.brand {
    text-style: bold;
    color: $accent-blue;
}

.separator {
    color: $text-muted;
}

.info-row {
    width: 100%;
    align: center middle;
    color: $text-muted;
}

/* Metrics Row */
MetricsRow {
    height: 5;
    margin: 1 0;
    align: center middle;
    layout: horizontal;
}

MetricCard {
    width: 1fr;
    height: 100%;
    background: $surface-lighten-1;
    border: round #727169;
    layout: vertical;
    align: center middle;
    margin: 0 1;
    padding: 0 1;
}

/* Color diversity for cards */
MetricCard.found { 
    border-left: tall $accent-green; 
    border-title-color: $accent-green;
    color: $accent-green;
}
MetricCard.accepted { 
    border-left: tall $accent-green; 
    border-title-color: $accent-green;
    color: $accent-green;
}
MetricCard.value { 
    border-left: tall $accent-yellow; 
    border-title-color: $accent-yellow;
    color: $accent-yellow;
}
MetricCard.rate { 
    border-left: tall $accent-orange; 
    border-title-color: $accent-orange;
    color: $accent-orange;
}
MetricCard.today { 
    border-left: tall $accent-violet; 
    border-title-color: $accent-violet;
    color: $accent-violet;
}

MetricCard:focus {
    border: round $accent-blue;
}

.metric-grid {
    layout: grid;
    grid-size: 2;
    grid-columns: auto 1fr;
    width: 100%;
    height: 1;
    align: center middle;
}

.metric-icon {
    color: $text;
    margin-right: 1;
}

.metric-value {
    text-style: bold;
    color: $text;
    width: 100%;
    text-align: right;
}

.metric-label {
    width: 100%;
    text-align: center;
    color: $text-muted;
    padding-bottom: 0;
}

/* Status Row */
StatusRow {
    height: 3;
    width: 100%;
    layout: horizontal;
    background: $surface-lighten-1;
    align: center middle;
    margin: 0 1 1 1;
    padding: 0 2;
    border: round #727169;
}

StatusIndicator {
    layout: horizontal;
    margin: 0 2;
    min-width: 10;
    align: center middle;
    width: 1fr;
}

.status-label {
    width: auto;
    color: $text-muted; /* Default color */
}

/* Status Colors - applied to indicator and inherited by label */
.status-live { 
    color: $accent-green; 
    text-style: bold;
}
.status-working { 
    color: $accent-orange; 
}
.status-error { 
    color: $accent-red; 
    text-style: bold;
}
.status-idle { 
    color: $text-muted; 
}

/* Pulsing animation for live status */
.status-live .status-label {
    color: $accent-green;
    text-style: bold;
}

/* Ensure label inherits color */
.status-working .status-label { color: $accent-orange; }
.status-error .status-label { color: $accent-red; }
.status-idle .status-label { color: $text-muted; }

.status-icon {
    margin-right: 1;
}

/* ... */

/* Dashboard Grid */
.dashboard-grid {
    layout: grid;
    grid-size: 2 2;
    grid-columns: 1fr 1fr;
    grid-rows: 1fr 1fr;
    margin: 0 1;
    height: 1fr;
    min-height: 20;
}

/* Panel styling */
.dashboard-panel {
    background: $surface;
    border: round $surface-lighten-1;
    padding: 0 1;
    height: 100%;
    margin: 0 1 1 1;
    border-title-color: $accent-blue;
    border-title-background: $surface;
}

/* Remove old quadrant title styling */
/* .quadrant-title { ... } - REMOVED */

/* Specific panel accents */
.dashboard-panel.jobs { border-left: tall $accent-blue; border-title-color: $accent-blue; }
/* ... */
.dashboard-panel.chart { border-left: tall $accent-green; border-title-color: $accent-green; }
.dashboard-panel.session { border-left: tall $accent-orange; border-title-color: $accent-orange; }
.dashboard-panel.sources { border-left: tall $accent-red; border-title-color: $accent-red; }

/* Activity log at bottom - grows to fill space */
.activity-panel {
    background: $surface;
    border: round $surface-lighten-1;
    border-left: tall $accent-orange;
    padding: 0 1;
    height: 1fr;
    min-height: 6;
    margin: 0 1 1 1;
}

.activity-panel .panel-title {
    color: $accent-blue;
    background: $surface-lighten-1;
    text-style: bold;
    dock: top;
    padding: 0 1;
}

DashboardQuadrant {
    border: round $surface-lighten-1;
    background: $surface;
    margin: 0 1 1 1;
    padding: 0 1;
    height: 100%;
}

.quadrant-title {
    background: $surface-lighten-1;
    color: $accent-blue;
    dock: top;
    padding: 0 1;
}

/* Specific Quadrants */
JobsPreview {
    height: 100%;
}

ActivityPreview {
    height: 100%;
}

RichLog {
    background: $surface;
    border: none;
    scrollbar-background: $surface;
    scrollbar-color: $surface-lighten-1;
}

DataTable {
    background: $surface;
    border: none;
    height: 100%;
}

DataTable > .datatable--header {
    background: $surface-lighten-1;
    color: $accent-blue;
}

/* Tabs */
TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 0;
}

Tabs {
    dock: top;
    background: $surface;
}

/* Footer & Input */
Input {
    dock: bottom;
    height: 3;
    border: round $surface-lighten-1;
    background: $surface;
}

Footer {
    dock: bottom;
    background: $surface-lighten-1;
    color: $text-muted;
}
