/* Theme aliases: these map directly to the currently selected Textual theme. */
$surface-muted: $border-blurred;
$accent-blue: $primary;
$accent-green: $success;
$accent-red: $error;
$accent-orange: $warning;
$accent-yellow: $warning-lighten-1;
$accent-violet: $secondary;
$accent-aqua: $accent;
$accent-pink: $accent-muted;

Screen {
    color: $text;
    background: $background;
}

/* ============================================================================
   Layout Components
   ============================================================================ */

/* Title Bar - seamless, no box */
TitleBar {
    height: 3;
    dock: top;
    layout: vertical;
    align: center middle;
    border: none;
}

.brand {
    text-style: bold;
    color: $accent-blue;
}

.separator {
    color: $surface-muted;
    display: none;
}

.info-row {
    width: 100%;
    align: center middle;
    color: $text-muted;
}

.config-info {
    color: $text-muted;
}

.dim {
    color: $surface-muted;
}

/* Metrics Row */
MetricsRow {
    height: 5;
    margin: 0 1;
    align: center middle;
    layout: horizontal;
}

MetricCard {
    width: 1fr;
    height: 100%;
    border: round $surface-muted;
    layout: vertical;
    align: center middle;
    margin: 0 1;
    padding: 0 1;
}

/* Card accents from current theme roles */
MetricCard.found { 
    border-left: tall $accent-green; 
    border-title-color: $accent-green;
    color: $accent-green;
}
MetricCard.accepted { 
    border-left: tall $accent-aqua; 
    border-title-color: $accent-aqua;
    color: $accent-aqua;
}
MetricCard.value { 
    border-left: tall $accent-yellow; 
    border-title-color: $accent-yellow;
    color: $accent-yellow;
}
MetricCard.rate { 
    border-left: tall $accent-orange; 
    border-title-color: $accent-orange;
    color: $accent-orange;
}
MetricCard.today { 
    border-left: tall $accent-violet; 
    border-title-color: $accent-violet;
    color: $accent-violet;
}

MetricCard:focus {
    border: round $accent-blue;
}

.metric-value {
    text-style: bold;
    color: $text;
    width: 1fr;
    text-align: center;
    height: 1fr;
    content-align: center middle;
}

/* Status Row - seamless, matches surface */
StatusRow {
    height: 3;
    width: 100%;
    layout: horizontal;
    align: center middle;
    margin: 0 1 1 1;
    padding: 0 2;
    border: round $surface-muted;
}

StatusIndicator {
    layout: horizontal;
    margin: 0 2;
    min-width: 10;
    align: center middle;
    width: 1fr;
}

.status-label {
    width: auto;
    color: $text-muted;
}

/* Status Colors */
.status-live { 
    color: $accent-green; 
    text-style: bold;
}
.status-working { 
    color: $accent-orange; 
}
.status-error { 
    color: $accent-red; 
    text-style: bold;
}
.status-idle { 
    color: $text-muted; 
}

.status-live .status-label {
    color: $accent-green;
    text-style: bold;
}
.status-working .status-label { color: $accent-orange; }
.status-error .status-label { color: $accent-red; }
.status-idle .status-label { color: $text-muted; }

.status-icon {
    margin-right: 1;
}

/* Dashboard Grid */
.dashboard-grid {
    layout: grid;
    grid-size: 2 2;
    grid-columns: 1fr 1fr;
    grid-rows: 1fr 1fr;
    margin: 0 1;
    height: 1fr;
    min-height: 20;
}

/* Panel styling - unified with surface */
.dashboard-panel {
    border: round $surface-muted;
    padding: 0 1;
    height: 100%;
    margin: 0 1 1 1;
    border-title-color: $accent-blue;
}

/* Specific panel accents */
.dashboard-panel.jobs { border-left: tall $accent-blue; border-title-color: $accent-blue; }
.dashboard-panel.chart { border-left: tall $accent-green; border-title-color: $accent-green; }
.dashboard-panel.session { border-left: tall $accent-orange; border-title-color: $accent-orange; }
.dashboard-panel.sources { border-left: tall $accent-red; border-title-color: $accent-red; }

/* Activity log at bottom */
.activity-panel {
    border: round $surface-muted;
    border-left: tall $accent-aqua;
    padding: 0 1;
    height: 1fr;
    min-height: 6;
    margin: 0 1 1 1;
}

.activity-panel .panel-title {
    color: $accent-blue;
    text-style: bold;
    dock: top;
    padding: 0 1;
}

DashboardQuadrant {
    border: round $surface-muted;
    margin: 0 1 1 1;
    padding: 0 1;
    height: 100%;
    border-title-color: $accent-blue;
}

.quadrant-title {
    color: $accent-blue;
    dock: top;
    padding: 0 1;
}

/* Specific Quadrants */
JobsPreview {
    height: 100%;
    border-title-color: $accent-blue;
}

ActivityPreview {
    height: 100%;
    border-title-color: $accent-aqua;
}

ChartPlaceholder {
    border-title-color: $accent-green;
}

JobsHourChart {
    border-title-color: $accent-green;
}

.chart-ascii {
    padding: 0 1;
    height: 100%;
}

ConfigPreview {
    border-title-color: $accent-violet;
}

SessionStats {
    border-title-color: $accent-orange;
}

RichLog {
    border: none;
    scrollbar-color: $surface-muted;
}

DataTable {
    border: none;
    height: 100%;
}

JobsPreview {
    height: 1fr;
}

DataTable > .datatable--header {
    color: $accent-blue;
}

/* Tabs */
TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 0;
}

Tabs {
    dock: top;
}

Tab {
    color: $text-muted;
}

Tab.-active {
    color: $text;
    text-style: bold;
}

Underline {
    color: $accent-blue;
}

/* Footer & Input */
Input {
    dock: bottom;
    height: 3;
    border: round $surface-muted;
}

Footer {
    dock: bottom;
    color: $text-muted;
}

FooterKey {
    color: $text;
}

FooterKey > .footer-key--key {
    color: $accent-blue;
}
