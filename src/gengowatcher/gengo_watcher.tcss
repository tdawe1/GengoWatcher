/* Kanagawa Theme Colors */
$surface: #1F1F28;
$surface-lighten-1: #2A2A37;
$text: #DCD7BA;
$text-muted: #727169;
$accent-blue: #7E9CD8;
$accent-green: #98BB6C;
$accent-red: #FF5D62;
$accent-orange: #DCA561;

Screen {
    background: $surface;
    color: $text;
}

/* ============================================================================
   Layout Components
   ============================================================================ */

/* Title Bar */
TitleBar {
    height: 3;
    background: $surface-lighten-1;
    border-bottom: solid $surface;
    dock: top;
    layout: vertical;
    align: center middle;
}

.brand {
    text-style: bold;
    color: $accent-blue;
}

.separator {
    color: $text-muted;
}

.info-row {
    width: 100%;
    align: center middle;
    color: $text-muted;
}

/* Metrics Row */
MetricsRow {
    height: 5;
    margin: 1 0;
    align: center middle;
    layout: horizontal;
}

MetricCard {
    width: 1fr;
    height: 100%;
    border: round $surface-lighten-1;
    background: $surface;
    layout: vertical;
    align: center middle;
    margin: 0 1;
}

MetricCard:focus {
    border: round $accent-blue;
}

.metric-value-row {
    width: 100%;
    align: center middle;
    height: 1fr;
}

.metric-icon {
    color: $accent-blue;
    margin-right: 1;
}

.metric-value {
    text-style: bold;
    color: $text;
}

.metric-label {
    width: 100%;
    text-align: center;
    color: $text-muted;
    padding-bottom: 0;
}

/* Status Row */
StatusRow {
    height: 3;
    width: 100%;
    layout: horizontal;
    background: $surface;
    align: center middle;
    margin-bottom: 1;
}

StatusIndicator {
    layout: horizontal;
    margin: 0 1;
    min-width: 12;
    align: center middle;
}

.status-icon {
    margin-right: 1;
}

/* ... */

/* Dashboard Grid */
.dashboard-grid {
    layout: grid;
    grid-size: 2 2;
    grid-columns: 1fr 1fr;
    grid-rows: 1fr 1fr;
    margin: 0 1;
    height: 1fr;
    min-height: 20;
}

/* Panel styling */
.dashboard-panel {
    background: $surface;
    border: round $surface-lighten-1;
    padding: 0 1;
    height: 100%;
    margin: 0 1 1 1;
    border-title-color: $accent-blue;
    border-title-background: $surface;
}

/* Remove old quadrant title styling */
/* .quadrant-title { ... } - REMOVED */

/* Specific panel accents */
.dashboard-panel.jobs { border-left: tall $accent-blue; border-title-color: $accent-blue; }
/* ... */
.dashboard-panel.chart { border-left: tall $accent-green; border-title-color: $accent-green; }
.dashboard-panel.session { border-left: tall $accent-orange; border-title-color: $accent-orange; }
.dashboard-panel.sources { border-left: tall $accent-red; border-title-color: $accent-red; }

/* Activity log at bottom - grows to fill space */
.activity-panel {
    background: $surface;
    border: round $surface-lighten-1;
    border-left: tall $accent-orange;
    padding: 0 1;
    height: 1fr;
    min-height: 6;
    margin: 0 1 1 1;
}

.activity-panel .panel-title {
    color: $accent-blue;
    background: $surface-lighten-1;
    text-style: bold;
    dock: top;
    padding: 0 1;
}

DashboardQuadrant {
    border: round $surface-lighten-1;
    background: $surface;
    margin: 0 1 1 1;
    padding: 0 1;
    height: 100%;
}

.quadrant-title {
    background: $surface-lighten-1;
    color: $accent-blue;
    dock: top;
    padding: 0 1;
}

/* Specific Quadrants */
JobsPreview {
    height: 100%;
}

ActivityPreview {
    height: 100%;
}

RichLog {
    background: $surface;
    border: none;
    scrollbar-background: $surface;
    scrollbar-color: $surface-lighten-1;
}

DataTable {
    background: $surface;
    border: none;
    height: 100%;
}

DataTable > .datatable--header {
    background: $surface-lighten-1;
    color: $accent-blue;
}

/* Tabs */
TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 0;
}

Tabs {
    dock: top;
    background: $surface;
}

/* Footer & Input */
Input {
    dock: bottom;
    height: 3;
    border: round $surface-lighten-1;
    background: $surface;
}

Footer {
    dock: bottom;
    background: $surface-lighten-1;
    color: $text-muted;
}
