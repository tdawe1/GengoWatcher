# GengoWatcher Environment Variables
# Copy this file to .env and fill in your values
# These override config.ini values for sensitive credentials

# Gengo WebSocket credentials (from browser cookies)
GENGO_USER_ID=
GENGO_USER_SESSION=
GENGO_USER_KEY=

# API authentication token (for web server)
GENGOWATCHER_API_TOKEN=

# Gmail OAuth (optional, for email monitoring)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Development mode (optional)
# GENGOWATCHER_DEV_MODE=false
